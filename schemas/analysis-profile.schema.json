{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia-labs.ai/schemas/mus-analysis/analysis-profile/1",
  "title": "MUS analysis profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["profileId", "version", "status", "question", "outputs"],
  "properties": {
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["specified", "foundation-implemented", "historically-imported", "validated", "deprecated"]
    },
    "question": {"type": "string", "minLength": 1},
    "operators": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "refusals": {"type": "array", "items": {"type": "string"}}
  }
}
