{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia-labs.ai/schemas/mus-analysis/run-receipt/1",
  "title": "MUS analysis immutable run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "run_kind",
    "profile",
    "operators",
    "parameters",
    "inputs",
    "outputs",
    "status",
    "started_at",
    "completed_at",
    "producer"
  ],
  "properties": {
    "schema": {"const": "https://sophia-labs.ai/schemas/mus-analysis/run-receipt/1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_kind": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "operators": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operator"}
    },
    "parameters": {"type": "object"},
    "environment": {"type": "object"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "status": {"enum": ["succeeded", "refused", "failed", "historical-import"]},
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "string", "minLength": 1},
    "source_revision": {"type": ["string", "null"]},
    "metadata": {}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "media_type", "byte_length"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "role": {"type": ["string", "null"]}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "version"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_digest": {"type": ["string", "null"]},
        "literature": {"type": "array", "items": {"type": "string"}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "profile_digest": {"type": ["string", "null"]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "loss", "ambiguity", "advisory"]},
        "message": {"type": "string", "minLength": 1},
        "anchor": {"type": ["string", "null"]},
        "detail": {"type": "object"}
      }
    }
  }
}
