{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia-labs.ai/schemas/mus-analysis/run-receipt/1",
  "title": "MUS analysis run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "canonicalization",
    "run_id",
    "run_type",
    "profile",
    "status",
    "producer",
    "started_at",
    "completed_at",
    "inputs",
    "outputs",
    "operators",
    "parameters",
    "environment",
    "diagnostics"
  ],
  "properties": {
    "schema": {"const": "https://sophia-labs.ai/schemas/mus-analysis/run-receipt/1"},
    "canonicalization": {"const": "mus-canonical-json/1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_type": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "status": {"enum": ["succeeded", "refused", "failed"]},
    "producer": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "operators": {"type": "array", "items": {"$ref": "#/$defs/operator"}},
    "parameters": {"type": "object"},
    "environment": {"type": "object"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "media_type", "byte_length", "role"],
      "properties": {
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "role": {"type": ["string", "null"]}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "digest"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"type": ["string", "null"]}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_id", "version", "implementation_digest", "source_url"],
      "properties": {
        "operator_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "implementation_digest": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "anchor", "detail"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "anchor": {"type": ["string", "null"]},
        "detail": {"type": "object"}
      }
    }
  }
}
