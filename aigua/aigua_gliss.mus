# score: Aigua — Sheet (glissando hocket)
# summary: 44 bars / 8 voices / ~1.4 min
# tempo: 208 (b1) → 232 (b17) → 208 (b37)
# time: 4/4
# key: A
# bars: 44
# tuning: A=445.6
# pack: instrument.json
# master: rms=-15

# text @b1: no static pitches. every note is a glissando, because the median
# text @b1: call in the source spans 18.7 semitones — these were never notes.
# text @b2: hocket, not chorale. six voices interlock an eighth apart and each
# text @b2: rests while the others move, so a single sweep is audible at speed.
# text @b3: the first version had all six sounding at once with heavy sends and
# text @b3: it collapsed into a wall. at this tempo a glissando needs air.
# text @b4: str=fit is load-bearing: a glide's natural length follows its
# text @b4: transposition, so without it the sweep gets cut off mid-flight.

# instruments:
#   bs = bass (bass, voice=buzz, str=fit, atk=0.02, rel=0.10, lpf=600, send=0.10, gain=-5)
#   g6 = voice 6 (bass, voice=buzz, str=fit, atk=0.010, rel=0.045, send=0.12, gain=-8)
#   g5 = voice 5 (treble, voice=mid, str=fit, atk=0.008, rel=0.040, send=0.13, gain=-9)
#   g4 = voice 4 (treble, voice=call, str=fit, atk=0.008, rel=0.040, send=0.14, gain=-9)
#   g3 = voice 3 (treble, voice=bright, str=fit, atk=0.007, rel=0.035, send=0.15, gain=-10)
#   g2 = voice 2 (treble, voice=glide, str=fit, atk=0.006, rel=0.035, send=0.16, gain=-12)
#   g1 = voice 1 (treble, voice=glide, s=2, str=fit, atk=0.006, rel=0.030, send=0.18, gain=-13)
#   pc = accent (perc, voice=tick, hpf=3600, rel=0.010, send=0.10, gain=-21)

