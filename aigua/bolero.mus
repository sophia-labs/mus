# score: Boléro (Ravel) — for birds recorded in Aigua
# summary: 340 bars / 9 voices / 15:27
# tempo: 66
# time: 3/4
# key: C
# bars: 340
# pack: instrument.json
# master: rms=-18

# text @b1: 340 bars, 3/4, crotchet=66 — Ravel's own marking, over the printed
# text @b1: 76. That gives 15:27, beside his 1930 recording at 15:50.
# text @b1: The snare figure is exact: ten strokes then fourteen, twenty-four
# text @b1: over two bars, unchanged 169 times from here to the end.
# text @b2: The two themes are RECONSTRUCTED, not transcribed — no score was
# text @b2: reachable. Theme A is diatonic, opens on C, falls through the octave
# text @b2: and bounces at its midpoint on G. Theme B opens on flat-7, descends
# text @b2: by semitone, spans two octaves and a minor second. The shape is
# text @b2: Ravel's; the notes are not.
# text @b3: Every sound is a bird from 56 seconds of tape. The tam-tam is a car.

# instruments:
#   sn = snare (perc, voice=tick, hpf=1800, rel=0.02, send=0.16, gain=-6)
#   ba = pizzicato bass (bass, voice=buzz, lpf=900, rel=0.05, send=0.10, gain=-7)
#   m1 = melody I (treble, voice=glide, send=0.26, gain=-4)
#   m2 = melody II (treble, voice=call, send=0.24, gain=-4)
#   m3 = melody III (treble, voice=bright, send=0.24, gain=-6)
#   m4 = melody IV (treble, voice=mid, send=0.24, gain=-6)
#   m5 = melody V (bass, voice=buzz, send=0.22, gain=-8)
#   tam = tam-tam (perc, voice=car, send=0.40, gain=-2)
#   gl = collapse (treble, voice=glide, s=3, str=fit, send=0.44, gain=-6)


