#   p1 = pad low (treble, voice=call, str=fit, atk=0.7, rel=2.9, send=0.42, gain=-6)
#   p2 = pad mid (treble, voice=mid, str=fit, atk=0.8, rel=3.1, send=0.44, gain=-7)
#   p3 = pad high (treble, voice=bright, str=fit, atk=0.9, rel=3.3, send=0.46, gain=-9)
#   sh = shimmer (treble, voice=glide, send=0.55, gain=-13)
#   ch = chirp (treble, voice=tick, send=0.35, gain=-16)

