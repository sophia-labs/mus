bar 70: dr={pp} Xh.[gate,lpf=120->90]

# section: coda [71-72] — one call, unshifted, unstretched, alone.
bar 71: dr={ppp} Xh.[gate,lpf=90->70]
# text @b72: the chant outlives the motet
bar 72: te={ppp} Xh.[gest=h60,str=1,atk=0.004,rel=0.06,send=0.5,gain=12]"amen"
