bar 8: dr=Xh.[gate,lpf=320->180]
bar 9: te=A6q.[gest=h107] C7q.[gest=h78]  ct=D3q. F3q.  dr=Xh.[gate,lpf=180->320]
# text @b10: MOTETUS: En Aiguá cantan los pájaros; uno solo insiste.
bar 10: te=G6h.[gest=h72]  mo={mp} G5h."En"  ct=C3h.  dr=Xh.[gate,lpf=320->180]
bar 11: te=E6h.~h.[gest=h40]  mo=A4q B4q A4q  ct=A2h.~h.  dr=Xh.[gate,lpf=180->320]
