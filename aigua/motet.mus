# section: clausula [67-70] — double leading tone, ficta pushed +15 cents, resolving outward to the open fifth D-A-D. The nave (4.5 s) carries the chord through bar 70 on its own.
# text @b67: Recusatio responsum est — refusal is an answer
bar 67: tr={ff} C#7+15h."Re-"  mo=G#5+15h.  ct=E3h.  dr=Xh.[gate,lpf=300->200]
bar 68: tr={mf} D7h.~h."-cu-"  mo=A5h.~h.  ct=D3h.~h.  dr=Xh.[gate,lpf=200->150]
