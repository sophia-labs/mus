@prefix musa: <https://sophia-labs.ai/ontology/mus-audio#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

musa:ArtifactShape a sh:NodeShape ;
    sh:targetClass musa:Artifact ;
    sh:property [ sh:path musa:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[0-9a-f]{64}$" ] ;
    sh:property [ sh:path musa:mediaType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path musa:byteLength ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 0 ] .

musa:AnalysisRunShape a sh:NodeShape ;
    sh:targetClass musa:AnalysisRun ;
    sh:property [ sh:path musa:runType ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:runStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("succeeded" "refused" "failed") ] ;
    sh:property [ sh:path musa:profileId ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:profileVersion ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:producer ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:startedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
    sh:property [ sh:path prov:endedAtTime ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] .

musa:EventHypothesisShape a sh:NodeShape ;
    sh:targetClass musa:EventHypothesis ;
    sh:property [ sh:path musa:targetsAsset ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path musa:startSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ] ;
    sh:property [ sh:path musa:endSeconds ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] ;
    sh:property [ sh:path musa:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class musa:EvidenceKind ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

musa:ObservationShape a sh:NodeShape ;
    sh:targetClass musa:Observation ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path musa:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class musa:EvidenceKind ] ;
    sh:property [ sh:path musa:observedPropertyId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path musa:procedureId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:or (
        [ sh:property [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ] ]
        [ sh:property [ sh:path musa:resultJson ; sh:minCount 1 ; sh:maxCount 1 ] ]
    ) ;
    sh:or (
        [ sh:property [ sh:path musa:scoreValue ; sh:maxCount 0 ] ]
        [
            sh:property [ sh:path musa:scoreValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ] ;
            sh:property [ sh:path musa:scoreSemantics ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ]
        ]
    ) .

musa:MembershipEstimateShape a sh:NodeShape ;
    sh:targetClass musa:MembershipEstimate ;
    sh:property [ sh:path musa:forTarget ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path musa:forClusterModel ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path musa:memberOfModelCluster ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path musa:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class musa:EvidenceKind ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

musa:InterpretationShape a sh:NodeShape ;
    sh:targetClass musa:Interpretation ;
    sh:property [ sh:path musa:forTarget ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path musa:interpretivePredicate ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:interpretiveValueJson ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class musa:EvidenceKind ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] .

musa:ClaimShape a sh:NodeShape ;
    sh:targetClass musa:Claim ;
    sh:property [ sh:path musa:claimText ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:claimStatus ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path musa:evidenceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:class musa:EvidenceKind ] ;
    sh:property [ sh:path prov:wasAttributedTo ; sh:minCount 1 ; sh:maxCount 1 ] .
